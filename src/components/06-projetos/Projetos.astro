---
// src/components/sections/Projetos.astro
import CardsCarrossel from './CardsCarrossel.jsx';
---

<section id="projetos" class="py-16 md:py-24 bg-gradient-to-b from-[#1852c0] to-[#0a2366] text-white overflow-hidden">
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6">
    
    <!-- Cabeçalho idêntico ao Layout do Figma -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-amber-400 leading-tight">
          Projetos que colocam a comunidade em prática
        </h2>
        <p class="text-sm sm:text-base text-blue-100 font-sans mt-3 leading-relaxed">
          A SouJunior aprende construindo. A comunidade desenvolve e mantém projetos reais que fortalecem o próprio ecossistema e criam experiências práticas para quem está começando na tecnologia.
        </p>
      </div>

      <a 
        href="#todos-projetos" 
        class="text-xs sm:text-sm font-bold uppercase tracking-wider text-white underline underline-offset-8 decoration-white/40 hover:decoration-amber-400 hover:text-amber-400 transition-colors shrink-0 self-start md:self-end"
      >
        PROJETOS DESTAQUES
      </a>
    </div>

    <!-- Carrossel 3D em Leque (CodePen) -->
    <CardsCarrossel client:visible />

  </div>
</section>