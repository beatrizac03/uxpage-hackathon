---
// src/components/01-hero/Hero.astro
import HeroReact from './Hero.jsx';
import heroAvatar from './hero_avatar.gif';
import { Image } from 'astro:assets';
---

<!-- Renderiza o componente React -->
<!-- <HeroReact /> -->
<section class="py-16 md:py-24 bg-(image:--gradient-1) min-h-[80vh]" id="hero">
  <!-- Contêiner centralizado limitando em 1140px -->
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <!-- Lado Esquerdo: Texto -->
      <div class="flex flex-col gap-6">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-(--amarelo-destaque) font-funnel-display">
          Você transforma oportunidade em experiência real
        </h1>
        <p class="text-lg text-(--branco)">
          Existimos para impulsionar a carreira de diversos profissionais iniciantes em tecnologia. Faça parte dessa transformação com doações a partir de R$ 2,00. 
        </p>
        <div class="flex gap-4">
          <a href="#comecar" class="px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition">
            Começar agora
          </a>
        </div>
      </div>

      <!-- Lado Direito: Imagem/Mídia -->
      <div class="flex justify-center h-150">
        <div class="w-full rounded-2xl flex items-center justify-center h-full-">
          <Image 
            src={heroAvatar} 
            alt="Descrição da imagem do Hero"
            class="h-150 rounded-xl shadow-lg object-cover"
          />
        </div>
      </div>

    </div>
  </div>
</section>