---
// src/components/02-metricas/Metricas.astro
import CountUp from './CountUp.jsx';
---

<section id="metricas" class="py-16 md:py-24 bg-slate-900 text-white">
  <!-- Container centralizado (1140px) com espaçamento de segurança -->
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6">
    
    <!-- Grid responsiva: 1 col no mobile, 2 no tablet, 4 no desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-6 text-center">
      
      <!-- Card 1 -->
      <div class="flex flex-col items-center justify-center p-6 bg-slate-800/50 rounded-2xl border border-slate-800 backdrop-blur-sm">
        <div class="font-display text-4xl sm:text-5xl font-bold text-blue-500 tracking-tight">
          <CountUp
            client:visible
            from={0}
            to={120}
            duration={2}
          />
        </div>
        <p class="text-sm md:text-base text-slate-300 font-medium mt-2">
          membros
        </p>
      </div>

      <!-- Card 2 -->
      <div class="flex flex-col items-center justify-center p-6 bg-slate-800/50 rounded-2xl border border-slate-800 backdrop-blur-sm">
        <div class="font-display text-4xl sm:text-5xl font-bold text-blue-500 tracking-tight flex items-center justify-center">
          <span>+</span>
          <CountUp
            client:visible
            from={0}
            to={50}
            duration={2}
          />
        </div>
        <p class="text-sm md:text-base text-slate-300 font-medium mt-2">
          profissionais inseridos no mercado de trabalho
        </p>
      </div>

      <!-- Card 3 -->
      <div class="flex flex-col items-center justify-center p-6 bg-slate-800/50 rounded-2xl border border-slate-800 backdrop-blur-sm">
        <div class="font-display text-4xl sm:text-5xl font-bold text-blue-500 tracking-tight">
          <CountUp
            client:visible
            from={0}
            to={35}
            duration={2}
          />
        </div>
        <p class="text-sm md:text-base text-slate-300 font-medium mt-2">
          mentores ativos
        </p>
      </div>

      <!-- Card 4 -->
      <div class="flex flex-col items-center justify-center p-6 bg-slate-800/50 rounded-2xl border border-slate-800 backdrop-blur-sm">
        <div class="font-display text-4xl sm:text-5xl font-bold text-blue-500 tracking-tight flex items-center justify-center gap-1">
          <CountUp
            client:visible
            from={0}
            to={4}
            duration={1.5}
          />
          <span>anos</span>
        </div>
        <p class="text-sm md:text-base text-slate-300 font-medium mt-2">
          de história
        </p>
      </div>

    </div>
  </div>
</section>