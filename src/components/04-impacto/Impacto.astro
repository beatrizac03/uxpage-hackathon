---
// src/components/sections/Impacto.astro
import TrilhaCarreira from './TrilhaCarreira.jsx';
import Scanner from '../common/Scanner.jsx';
---

<section id="impacto" class="py-24 lg:py-32 text-slate-900 overflow-hidden relative min-h-[85vh] flex items-center bg-slate-50">
  
  {/* Fundo Scanner */}
  <div class="absolute inset-0 z-0 w-full h-full opacity-65 pointer-events-none">
    <Scanner
      client:load
      color1="#3B82F6"
      color2="#6366F1"
      color3="#06B6D4"
      speed={0.5}
      sweepSpeed={0.3}
      sweepWidth={2.2}
      sweepFalloff={5}
      scale={1.6}
      frequency={2.5}
      ripple={0.4}
      bandDensity={12}
      lineSharpness={6}
      glow={0.4}
      scanDirection="vertical"
      colorSpread={0.8}
      brightness={1.3}
      contrast={1.2}
      softness={1.5}
      vignette={0.2}
      scanline
      grain
      grainIntensity={0.02}
      opacity={0.85}
      mouseInteraction
      mouseRadius={0.6}
      mouseStrength={0.6}
    />
  </div>

  {/* Conteúdo Principal */}
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/* Coluna da Esquerda: Textos */}
      <div class="lg:col-span-5 space-y-6 text-center lg:text-left">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-blue-950 leading-tight text-balance">
          Do aprendizado à primeira oportunidade real
        </h2>

        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
          Cada apoio financia a estrutura que sustenta esse caminho: mentoria ativa, projetos reais e uma comunidade que aprende fazendo, junta.
        </p>
      </div>

      {/* Coluna da Direita: Trilha Interativa sem overflow estourado */}
      <div class="lg:col-span-7 flex justify-center items-center w-full py-4">
        <div class="w-full max-w-[600px] px-2">
          <TrilhaCarreira client:visible />
        </div>
      </div>

    </div>
  </div>

</section>